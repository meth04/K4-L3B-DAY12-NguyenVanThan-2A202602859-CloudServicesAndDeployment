# Bản 1-stage — CHỈ DÙNG ĐỂ ĐO SO SÁNH cho exercises.md Câu 3.
# Đây là Dockerfile "chạy được nhưng chưa production" ban đầu của lab:
# một stage, chạy root, base image đầy đủ, COPY . . trước pip install.
# Bản production dùng để nộp là ./Dockerfile.
#
#   docker build -f Dockerfile.single-stage -t agent:single .
#   docker build -t agent:multi .
#   docker images | grep agent

FROM python:3.11

WORKDIR /app

COPY . .

RUN pip install -r requirements.txt

EXPOSE 8000

CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
