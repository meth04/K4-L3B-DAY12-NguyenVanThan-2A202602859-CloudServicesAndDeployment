# Quyết định thứ KHÔNG được copy vào build context / image.
# Bỏ sót .env = leak secret vào image. Bỏ sót .git = image phình to.

# Secrets — tuyệt đối không vào image
.env
.env.*
!.env.example
*.pem
*.key

# Git & CI
.git
.gitignore
.github

# Môi trường ảo & cache Python
.venv
venv
env
__pycache__
*.py[cod]
*.egg-info
.pytest_cache

# Tài liệu & công cụ không cần trong image
tests
screenshots
solution
Dockerfile
docker-compose.yml
.dockerignore
*.md

# OS / editor
.DS_Store
Thumbs.db
.idea
.vscode
